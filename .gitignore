# Extracted model files (use unrar to extract from .rar archives)
model/*.pth

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Detection results
result/
result_africa/
temp/
test/

# Downloaded tiles
imgs/*.tif
!imgs/sample*.tif  # Keep sample images

# Progress tracking files (user-specific)
gee_export_progress.json
africa_processing_progress.json
africa_tiles_2021_*.json

# Final outputs (user-specific)
africa_cpis_2021.*
africa_cpis_2021_summary.json

# Failed image list
fail_img.txt

# HPC-specific config (user customizes this)
hpc_config.pyc

# Batch image files
imgs_batch/*
imgs_batch_u8/*

# Temporary output files
*.out

# Environment files
environment.yml

# Pipeline state
pipeline_state.json

# Images cache/raw
imgs_cache_u8/*
imgs_cache_raw/*
!imgs_cache_u8/.gitignore
!imgs_cache_raw/.gitignore

# Manual test
manual_test/*