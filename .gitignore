# Extracted model files (use unrar to extract from .rar archives)
model/*.pth

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Detection results
result/
result_africa/
temp/
test/

# Downloaded tiles
imgs/*.tif
!imgs/sample*.tif  # Keep sample images
imgs_test/**

# Progress tracking files (user-specific)
gee_export_progress.json
africa_processing_progress.json
africa_tiles_2021_*.json

# Final outputs (user-specific)
africa_cpis_2021.*
africa_cpis_2021_summary.json

# Failed image list
fail_img.txt

# HPC-specific config (user customizes this)
hpc_config.pyc

# GEE demo download script
download_sentinel2_gee.py

# New Landsat-first pipeline runtime artifacts
data/**
!data/.gitkeep
runs/**
!runs/.gitkeep
outputs/**
!outputs/final/
!outputs/final/.gitkeep
models/*.joblib
models/*.meta.json
models/*calibration_report*.json
models/*feature_schema*.json
assets/regions/arid_ssa.geojson
assets/regions/arid_ssa_summary.json

# Local archive staging from cleanup passes
archive/**
